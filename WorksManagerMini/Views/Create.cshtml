@model WorksManagerMini.Models.Employee
<h2>Create Employee</h2>
<form action="/Employees/Create" method="post">
    <input name="Name" placeholder="Name" class="form-control" /><br />
    <input name="Phone" placeholder="Phone" class="form-control" /><br />
    <input name="Role" placeholder="Role" class="form-control" /><br />
    <button type="submit" class="btn btn-success">Save</button>
</form>