@model List<WorksManagerMini.Models.Job>
<h2>All Jobs</h2>
<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="searchString" class="form-control" placeholder="Customer name / Customer ID " />
        <button type="submit" class="btn btn-primary">Search</button>
        <a href="/Jobs" class="btn btn-secondary">Clear</a>
    </div>
</form>
<a href="/Jobs/Create" class="btn btn-primary">+ New Job</a>
<br />
<br />
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Title</th>
            <th>Customer</th>
            <th>Phone</th>
            <th>Work Type</th>
            <th>Assigned</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var job in Model)
        {
            <tr>
                <td>@job.Title</td>
                <td>@job.CustomerName</td>
                <td>@job.Phone</td>
                <td>@job.WorkType</td>
                <td>@job.AssignedTo</td>
                <td>
                    @if (job.Status == "Open")
                    {
                        <span class="badge bg-warning">Open</span>
                    }
                    else if (job.Status == "Completed")
                    {

                        <span class="badge bg-success">Completed</span>
                    }
                    else
                    {

                        <span class="badge bg-primary">@job.Status</span>
                    }
                </td>
                <td>
                    <a href="/Jobs/Edit/@job.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a href="/Jobs/Delete/@job.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
