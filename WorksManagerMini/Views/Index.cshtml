@model IEnumerable<WorksManagerMini.Models.Employee>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold">👷 Employees Dashboard</h2>
            <p class="text-muted">Works Manager Mini</p>
        </div>
        <a href="/Employees/Create" class="btn btn-primary">+ Add Employee</a>
    </div>

    <div class="row mt-3">
        <div class="col-md-4"><div class="card bg-primary text-white p-3 shadow"><h6>Total</h6><h1>@ViewBag.Total</h1></div></div>
        <div class="col-md-4"><div class="card bg-success text-white p-3 shadow"><h6>Managers</h6><h1>@ViewBag.Managers</h1></div></div>
        <div class="col-md-4"><div class="card bg-warning text-dark p-3 shadow"><h6>Workers</h6><h1>@ViewBag.Workers</h1></div></div>
    </div>

    <div class="card mt-4 shadow">
        <table class="table table-hover mb-0">
            <thead class="table-dark"><tr><th>ID</th><th>Name</th><th>Phone</th><th>Role</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td class="fw-bold">@item.Name</td>
                        <td>@item.Phone</td>
                        <td><span class="badge bg-info">@item.Role</span></td>
                        <td>
                            <a href="/Employees/Edit/@item.Id" class="btn btn-sm btn-warning">Edit</a>
                            <a href="/Employees/Delete/@item.Id" class="btn btn-sm btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>