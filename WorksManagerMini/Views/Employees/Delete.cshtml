@model WorksManagerMini.Models.Employee
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-4" style="max-width:500px">
    <h3 class="fw-bold text-danger">🗑️ Delete Employee</h3>
    <div class="card p-4 shadow mt-3 text-center">
        <h4>Are you sure da machan?</h4>
        <p class="text-muted">Nee <b>@Model.Name</b> ah delete panna pora da!</p>
        <p>Phone: @Model.Phone | Role: @Model.Role</p>

        <form action="/Employees/Delete/@Model.Id" method="post" class="d-flex gap-2 justify-content-center mt-3">
            <input type="hidden" name="Id" value="@Model.Id" />
            <a href="/Employees" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-danger">Yes, Delete</button>
        </form>
    </div>
</div>