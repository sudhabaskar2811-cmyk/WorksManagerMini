@model IEnumerable<WorksManagerMini.Models.Employee>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-4">
    <h2 class="fw-bold">👷 Employees Dashboard</h2>

    <table class="table table-hover mt-3">
        <thead>
            <tr><th>#</th><th>Name</th><th>Phone</th><th>Role</th><th>Action</th></tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Phone</td>
                    <td>@item.Role</td>
                    <td>
                        <a href="/Employees/Edit/@item.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a href="/Employees/Delete/@item.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <a href="/Employees/Create" class="btn btn-primary">+ Add Employee</a>
</div>